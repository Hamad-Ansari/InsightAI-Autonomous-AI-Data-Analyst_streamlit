# =====================================================================
# InsightAI — Environment configuration
# Copy to `.env` and adjust as needed. All values have sane defaults.
# =====================================================================

# --- Ollama (local LLM) -------------------------------------------------
# Base URL of the running Ollama server.
OLLAMA_BASE_URL=http://localhost:11434
# Default model used for reasoning / business insights.
OLLAMA_MODEL=llama3.2:3b
OLLAMA_TEMPERATURE=0.3
OLLAMA_MAX_TOKENS=1200
OLLAMA_TIMEOUT=90

# --- RAG (knowledge base) ------------------------------------------------
# Sentence-transformer embedding model (falls back to TF-IDF if not installed).
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
# Where the vector index / store is persisted.
VECTOR_DB_PATH=./rag/vectorstore
# Number of chunks retrieved per query.
RAG_TOP_K=5

# --- Application ---------------------------------------------------------
# Maximum upload size in megabytes.
MAX_UPLOAD_SIZE_MB=200
# Logging level: DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
